modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ACUITY_CALENDAR_URL = "https://app.acuityscheduling.com/schedule.php?owner=36930698"
ACUITY_USER_ID = "36930698"
VITE_ACUITY_CALENDAR_URL = "https://app.acuityscheduling.com/schedule.php?owner=36930698"
VITE_BUSINESS_NAME = "Fit Club"
EXPO_PUBLIC_ACUITY_CALENDAR_URL = "https://app.acuityscheduling.com/schedule.php?owner=36930698"
ADMIN_EMAIL = "info@fitclub15.com"
VITE_ADMIN_EMAIL = "info@fitclub15.com"
