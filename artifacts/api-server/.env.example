# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Clerk (server-side auth) ──────────────────────────────────────────────────
# Get from: dashboard.clerk.com → your app → API Keys → Secret key
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Acuity Scheduling ─────────────────────────────────────────────────────────
# Get from: acuityscheduling.com → Account → Integrations → API credentials
ACUITY_USER_ID=your_acuity_user_id
ACUITY_API_KEY=your_acuity_api_key

# Acuity owner ID (visible in your account URL / API credentials page)
ACUITY_OWNER_ID=36930698

# Appointment type IDs — find these in Acuity under Appointment Types
ACUITY_TYPE_FREE_TRIAL=
ACUITY_TYPE_RED_LIGHT_THERAPY=
ACUITY_TYPE_WORKOUT_FOR_1=83398355

# Required Terms & Conditions intake form values from Acuity → GET /forms.
ACUITY_TERMS_FORM_ID=3140997
ACUITY_TERMS_FIELD_ID=17742013

# ── Locations (Acuity calendar IDs) ───────────────────────────────────────────
# Find calendar IDs in Acuity → Availability → Calendars
LOCATION_1_NAME=POTOMAC
LOCATION_1_CALENDAR_ID=12741713

LOCATION_2_NAME=KENTLANDS
LOCATION_2_CALENDAR_ID=14311114

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ── Misc ──────────────────────────────────────────────────────────────────────
# Timezone used when formatting booking times
BOOKING_TIMEZONE=America/New_York

# Comma-separated extra CORS origins (beyond the portal origin).
# Leave blank for local dev with the portal on the same machine.
CORS_ORIGIN=
