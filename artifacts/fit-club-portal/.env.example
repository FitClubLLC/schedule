# ── Server (Vite dev server) ──────────────────────────────────────────────────
PORT=5173
# Must be "/" for local dev (on Replit this is set to the artifact's path prefix)
BASE_PATH=/

# ── Clerk (client-side auth) ──────────────────────────────────────────────────
# Get from: dashboard.clerk.com → your app → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Clerk proxy URL (leave blank for local dev)
VITE_CLERK_PROXY_URL=

# ── Admin ─────────────────────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin@example.com

# ── Locations ─────────────────────────────────────────────────────────────────
VITE_LOCATION_1_NAME=POTOMAC
VITE_LOCATION_1_CALENDAR_ID=12741713

VITE_LOCATION_2_NAME=KENTLANDS
VITE_LOCATION_2_CALENDAR_ID=14311114
